  private async Task GenerateCsvExport()
  {
    if (_exceptionsDF == null) return;
    var sb = new StringBuilder();
    sb.AppendLine(string.Join(",", _exceptionsDF.Columns.Cast<DataColumn>().Select(c => c.ColumnName)));
    foreach (DataRow row in _exceptionsDF.Rows)
      sb.AppendLine(string.Join(",", row.ItemArray.Select(v => $"\"{v}\"")));
    var bytes = Encoding.UTF8.GetBytes(sb.ToString());
    var b64   = Convert.ToBase64String(bytes);
    await JSRuntime.InvokeVoidAsync("downloadFile", "JE_Exceptions.csv", "text/csv", b64);
  }

