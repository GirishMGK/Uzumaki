@* JEAuditApp.razor
   NuGet packages required:
     - EPPlus (version 5.x or 6.x, non-commercial license) for Excel read/write
     - Microsoft.AspNetCore.Components.Forms (included in Blazor Server SDK)
   Add to _Host.cshtml or App.razor:
     <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
*@

@page "/je-audit"
@using System.Data
@using System.IO
@using System.Text
@using System.Text.Json
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime

<style>
  /* ── Reset / base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', sans-serif; background: #f0f2f6; }

  /* ── Hero banner ── */
  .hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 70%, #533483 100%);
    padding: 2.5rem 2rem 2rem;
    color: white;
    border-radius: 0 0 1.5rem 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 24px rgba(0,0,0,.35);
  }
  .hero h1 { font-size: 2rem; font-weight: 700; letter-spacing: .5px; }
  .hero p  { font-size: .95rem; color: #c9d1e8; margin-top: .4rem; }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.3);
    border-radius: 999px;
    padding: .2rem .8rem;
    font-size: .78rem;
    margin-right: .4rem;
  }

  /* ── Layout ── */
  .app-layout { display: flex; min-height: calc(100vh - 180px); gap: 1rem; padding: 0 1rem 2rem; }
  .sidebar {
    width: 220px; flex-shrink: 0;
    background: white;
    border-radius: 1rem;
    padding: 1rem .5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
    height: fit-content;
    position: sticky; top: 1rem;
  }
  .sidebar-item {
    display: flex; align-items: center; gap: .5rem;
    padding: .6rem .9rem;
    border-radius: .6rem;
    cursor: pointer;
    font-size: .88rem;
    color: #444;
    transition: background .15s, color .15s;
    border: none; background: transparent; width: 100%; text-align: left;
  }
  .sidebar-item:hover  { background: #f0f0ff; color: #5c4fff; }
  .sidebar-item.active { background: linear-gradient(90deg,#667eea,#764ba2); color: white; font-weight: 600; }
  .main-content { flex: 1; min-width: 0; }

  /* ── Section card ── */
  .section-card {
    background: white; border-radius: 1rem;
    padding: 1.5rem; margin-bottom: 1.2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.07);
  }
  .section-title {
    font-size: 1.2rem; font-weight: 700; color: #1a1a2e;
    border-left: 4px solid #667eea;
    padding-left: .75rem; margin-bottom: 1rem;
  }

  /* ── KPI cards ── */
  .kpi-grid { display: flex; flex-wrap: wrap; gap: .8rem; margin-bottom: 1.2rem; }
  .kpi-card {
    border-radius: .8rem; padding: 1rem 1.4rem;
    min-width: 140px; flex: 1;
    color: white;
    box-shadow: 0 2px 10px rgba(0,0,0,.15);
  }
  .kpi-card.blue   { background: linear-gradient(135deg,#667eea,#764ba2); }
  .kpi-card.red    { background: linear-gradient(135deg,#FF3B3B,#c0392b); }
  .kpi-card.orange { background: linear-gradient(135deg,#FF8C00,#e67e22); }
  .kpi-card.green  { background: linear-gradient(135deg,#4CAF50,#27ae60); }
  .kpi-card.teal   { background: linear-gradient(135deg,#00b4d8,#0077b6); }
  .kpi-card.purple { background: linear-gradient(135deg,#9b59b6,#8e44ad); }
  .kpi-val { font-size: 1.8rem; font-weight: 700; }
  .kpi-lbl { font-size: .78rem; opacity: .9; margin-top: .1rem; }

  /* ── Risk badges ── */
  .badge { display:inline-block; padding:.2rem .7rem; border-radius:999px; font-size:.76rem; font-weight:600; }
  .badge-critical { background:#FF3B3B; color:white; }
  .badge-high     { background:#FF8C00; color:white; }
  .badge-medium   { background:#F5A623; color:white; }
  .badge-low      { background:#4CAF50; color:white; }

  /* ── Tables ── */
  .data-table { width:100%; border-collapse:collapse; font-size:.85rem; }
  .data-table th { background:#f8f9ff; color:#444; font-weight:600; padding:.55rem .75rem; border-bottom:2px solid #e8eaf6; text-align:left; }
  .data-table td { padding:.5rem .75rem; border-bottom:1px solid #f0f0f0; vertical-align:top; }
  .data-table tr:hover td { background:#fafbff; }

  /* ── Form controls ── */
  .form-group { margin-bottom: .9rem; }
  .form-label { font-size: .83rem; font-weight: 600; color: #555; margin-bottom: .3rem; display: block; }
  .form-control {
    width: 100%; padding: .45rem .7rem;
    border: 1.5px solid #d1d5db; border-radius: .5rem;
    font-size: .88rem; color: #222;
    transition: border-color .15s;
    outline: none;
  }
  .form-control:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,.15); }
  select.form-control { background: white; }

  /* ── Buttons ── */
  .btn {
    padding: .5rem 1.2rem; border-radius: .5rem; border: none;
    font-size: .88rem; font-weight: 600; cursor: pointer;
    transition: opacity .15s, transform .1s;
  }
  .btn:hover { opacity: .88; transform: translateY(-1px); }
  .btn:active { transform: translateY(0); }
  .btn-primary  { background: linear-gradient(90deg,#667eea,#764ba2); color: white; }
  .btn-success  { background: linear-gradient(90deg,#4CAF50,#27ae60); color: white; }
  .btn-danger   { background: linear-gradient(90deg,#FF3B3B,#c0392b); color: white; }
  .btn-secondary{ background: #e8eaf6; color: #444; }
  .btn-sm       { padding: .3rem .8rem; font-size: .8rem; }

  /* ── Progress ── */
  .progress-bar-wrap { background: #e8eaf6; border-radius: 999px; height: 12px; overflow: hidden; margin: .5rem 0; }
  .progress-bar-fill { height: 100%; background: linear-gradient(90deg,#667eea,#764ba2); border-radius: 999px; transition: width .4s; }

  /* ── Upload zone ── */
  .upload-zone {
    border: 2px dashed #c7d2fe; border-radius: .8rem;
    padding: 1.5rem; text-align: center;
    background: #f8f9ff; margin-bottom: .8rem;
    transition: border-color .2s;
  }
  .upload-zone:hover { border-color: #667eea; }
  .upload-icon { font-size: 2rem; }

  /* ── Alert ── */
  .alert { border-radius: .6rem; padding: .7rem 1rem; margin-bottom: .8rem; font-size: .87rem; }
  .alert-info    { background: #e0e7ff; color: #3730a3; border-left: 4px solid #667eea; }
  .alert-success { background: #dcfce7; color: #166534; border-left: 4px solid #4CAF50; }
  .alert-warning { background: #fef3c7; color: #92400e; border-left: 4px solid #F5A623; }
  .alert-danger  { background: #fee2e2; color: #991b1b; border-left: 4px solid #FF3B3B; }

  /* ── Checkbox / toggle ── */
  .check-group { display: flex; flex-wrap: wrap; gap: .6rem; }
  .check-item  { display: flex; align-items: center; gap: .4rem; font-size: .87rem; padding: .4rem .8rem; border-radius: .4rem; background: #f8f9ff; cursor: pointer; }
  .check-item input { accent-color: #667eea; }

  /* ── Chart container ── */
  .chart-container { width: 100%; height: 320px; border-radius: .8rem; overflow: hidden; }

  /* ── Responsive ── */
  @media (max-width:768px) {
    .app-layout { flex-direction: column; }
    .sidebar { width: 100%; position: static; display: flex; flex-wrap: wrap; gap: .3rem; }
    .sidebar-item { width: auto; }
  }
</style>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!--  HERO BANNER                                                    -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="hero">
  <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
    <div>
      <h1>⚡ JE Audit Analytics Tool</h1>
      <p>AI-powered Journal Entry Audit &amp; Exception Detection Platform</p>
      <div style="margin-top:.7rem;">
        <span class="hero-badge">v2.0</span>
        <span class="hero-badge">Blazor Server</span>
        <span class="hero-badge">EPPlus</span>
        @if (_runDone)
        {
          <span class="hero-badge" style="background:rgba(76,175,80,.3);border-color:#4CAF50;">✔ Analysis Complete</span>
        }
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!--  MAIN LAYOUT                                                    -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="app-layout">

  <!-- ── Sidebar navigation ── -->
  <nav class="sidebar">
    @foreach (var (icon, label, key) in _navItems)
    {
      <button class="sidebar-item @(_currentPage == key ? "active" : "")"
              @onclick="() => _currentPage = key">
        <span>@icon</span><span>@label</span>
      </button>
    }
  </nav>

  <!-- ── Page content ── -->
  <main class="main-content">
    @switch (_currentPage)
    {
      case "upload":    @RenderUploadPage();    break;
      case "mapping":   @RenderMappingPage();   break;
      case "params":    @RenderParamsPage();    break;
      case "run":       @RenderRunPage();       break;
      case "results":   @RenderResultsPage();   break;
      case "dashboard": @RenderDashboard();     break;
      case "export":    @RenderExportPage();    break;
    }
  </main>
</div>

