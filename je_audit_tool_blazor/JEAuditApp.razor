  private async Task OnGlFileChanged(InputFileChangeEventArgs e)
  {
    _uploadStatus = "⏳ Parsing file...";
    StateHasChanged();
    var file = e.File;
    _df = await ParseFileToDataTable(file);
    if (_df != null)
    {
      AutoMapColumns();
      _uploadStatus = $"✅ Loaded {_df.Rows.Count:N0} rows × {_df.Columns.Count} columns from '{file.Name}'";
    }
  }

  private async Task OnDocTypeFileChanged(InputFileChangeEventArgs e)
  {
    var dt = await ParseFileToDataTable(e.File);
    if (dt != null && dt.Columns.Count >= 2)
    {
      _docTypeMap.Clear();
      foreach (DataRow r in dt.Rows)
      {
        var k = r[0]?.ToString() ?? ""; var v = r[1]?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(k)) _docTypeMap[k] = v;
      }
      _docTypeStatus = $"✅ {_docTypeMap.Count} doc types loaded";
    }
  }

  private async Task OnHolidayFileChanged(InputFileChangeEventArgs e)
  {
    var dt = await ParseFileToDataTable(e.File);
    if (dt != null)
    {
      _customHolidays.Clear();
      foreach (DataRow r in dt.Rows)
        if (DateTime.TryParse(r[0]?.ToString(), out var d))
          _customHolidays.Add(d.Date);
      _holidayStatus = $"✅ {_customHolidays.Count} holidays loaded";
    }
  }

  private async Task OnVendorFileChanged(InputFileChangeEventArgs e)
  {
    _vendorMasterDF = await ParseFileToDataTable(e.File);
    _vendorStatus   = _vendorMasterDF != null
      ? $"✅ {_vendorMasterDF.Rows.Count} vendor records loaded"
      : "❌ Failed to parse vendor file";
  }

  private async Task OnRelatedPartyFileChanged(InputFileChangeEventArgs e)
  {
    var dt = await ParseFileToDataTable(e.File);
    if (dt != null)
    {
      _relatedPartyList.Clear();
      foreach (DataRow r in dt.Rows)
      {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        for (int c = 0; c < dt.Columns.Count; c++)
          d[dt.Columns[c].ColumnName] = r[c]?.ToString() ?? "";
        _relatedPartyList.Add(d);
      }
      _relatedPartyStatus = $"✅ {_relatedPartyList.Count} related party records loaded";
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  //  RENDER FRAGMENTS — PAGE 1: UPLOAD DATA
  // ═══════════════════════════════════════════════════════════════════

  private RenderFragment RenderUploadPage() =>
  @<div>
    <div class="section-card">
      <div class="section-title">📁 Upload Data Files</div>
      <div class="alert alert-info">
        Upload your GL / Journal Entry data along with reference master files.
        Supported formats: <strong>.csv</strong>, <strong>.xlsx</strong> (EPPlus required for Excel).
      </div>

      @* ── GL / JE Data ── *@
      <div class="form-group">
        <label class="form-label">📊 GL / Journal Entry Data <span style="color:red">*</span></label>
        <div class="upload-zone">
          <div class="upload-icon">📂</div>
          <div style="font-size:.9rem;color:#666;margin:.4rem 0;">Drag &amp; drop or click to browse</div>
          <InputFile OnChange="OnGlFileChanged" accept=".csv,.xlsx,.xls" style="margin-top:.5rem;" />
        </div>
        @if (!string.IsNullOrEmpty(_uploadStatus))
        {
          <div class="alert @(_uploadStatus.StartsWith("✅") ? "alert-success" : _uploadStatus.StartsWith("❌") ? "alert-danger" : "alert-info")" style="margin-top:.4rem;">
            @_uploadStatus
          </div>
        }
      </div>

      @* ── Data preview ── *@
      @if (_df != null)
      {
        <div style="overflow-x:auto;max-height:260px;">
          <table class="data-table">
            <thead>
              <tr>@foreach (DataColumn col in _df.Columns) { <th>@col.ColumnName</th> }</tr>
            </thead>
            <tbody>
              @for (int r = 0; r < Math.Min(10, _df.Rows.Count); r++)
              {
                var row = _df.Rows[r];
                <tr>@foreach (DataColumn col in _df.Columns) { <td>@row[col]</td> }</tr>
              }
            </tbody>
          </table>
        </div>
        @if (_df.Rows.Count > 10)
        {
          <div style="font-size:.8rem;color:#888;margin-top:.3rem;">
            Showing 10 of @_df.Rows.Count rows
          </div>
        }
      }
    </div>

    @* ── Reference Files ── *@
    <div class="section-card">
      <div class="section-title">📎 Reference / Master Files (Optional)</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">

        <div class="form-group">
          <label class="form-label">📄 Document Type Master</label>
          <div class="upload-zone">
            <InputFile OnChange="OnDocTypeFileChanged" accept=".csv,.xlsx,.xls" />
          </div>
          @if (!string.IsNullOrEmpty(_docTypeStatus))
          {
            <div class="alert alert-success" style="margin-top:.3rem;">@_docTypeStatus</div>
          }
        </div>

        <div class="form-group">
          <label class="form-label">📅 Holiday List</label>
          <div class="upload-zone">
            <InputFile OnChange="OnHolidayFileChanged" accept=".csv,.xlsx,.xls" />
          </div>
          @if (!string.IsNullOrEmpty(_holidayStatus))
          {
            <div class="alert alert-success" style="margin-top:.3rem;">@_holidayStatus</div>
          }
        </div>

        <div class="form-group">
          <label class="form-label">🏢 Vendor Master</label>
          <div class="upload-zone">
            <InputFile OnChange="OnVendorFileChanged" accept=".csv,.xlsx,.xls" />
          </div>
          @if (!string.IsNullOrEmpty(_vendorStatus))
          {
            <div class="alert alert-success" style="margin-top:.3rem;">@_vendorStatus</div>
          }
        </div>

        <div class="form-group">
          <label class="form-label">🔗 Related Party List</label>
          <div class="upload-zone">
            <InputFile OnChange="OnRelatedPartyFileChanged" accept=".csv,.xlsx,.xls" />
          </div>
          @if (!string.IsNullOrEmpty(_relatedPartyStatus))
          {
            <div class="alert alert-success" style="margin-top:.3rem;">@_relatedPartyStatus</div>
          }
        </div>
      </div>
    </div>

    <div style="text-align:right;">
      <button class="btn btn-primary" @onclick='() => _currentPage = "mapping"'
              disabled="@(_df == null)">
        Next: Column Mapping →
      </button>
    </div>
  </div>;

  // ═══════════════════════════════════════════════════════════════════
  //  PAGE 2: COLUMN MAPPING
  // ═══════════════════════════════════════════════════════════════════

  private RenderFragment RenderMappingPage() =>
  @<div>
    <div class="section-card">
      <div class="section-title">🔗 Column Mapping</div>
      @if (_df == null)
      {
        <div class="alert alert-warning">Please upload GL data first (Upload Data page).</div>
      }
      else
      {
        <div class="alert alert-info">
          Auto-mapping detected <strong>@_colMap.Count</strong> of @RequiredFields.Length fields.
          Review and adjust the mappings below.
        </div>

        var availableCols = new[] { "(not mapped)" }.Concat(
          _df.Columns.Cast<DataColumn>().Select(c => c.ColumnName)).ToArray();

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.7rem;">
          @foreach (var field in RequiredFields)
          {
            _colMap.TryGetValue(field, out var mapped);
            <div class="form-group" style="margin-bottom:.5rem;">
              <label class="form-label" style="font-size:.8rem;">@field</label>
              <select class="form-control"
                      value="@(mapped ?? "(not mapped)")"
                      @onchange='e => UpdateColMap(field, e.Value?.ToString())'>
                @foreach (var col in availableCols)
                {
                  <option value="@col" selected="@(col == (mapped ?? "(not mapped)"))">@col</option>
                }
              </select>
            </div>
          }
        </div>

        <div style="margin-top:1rem;display:flex;gap:.7rem;flex-wrap:wrap;">
          <button class="btn btn-secondary" @onclick="AutoMapColumns">🔄 Re-run Auto-Map</button>
          <button class="btn btn-primary" @onclick='() => _currentPage = "params"'>
            Next: Audit Parameters →
          </button>
        </div>
      }
    </div>
  </div>;

  private void UpdateColMap(string field, string? value)
  {
    if (value == null || value == "(not mapped)")
      _colMap.Remove(field);
    else
      _colMap[field] = value;
  }

  // ═══════════════════════════════════════════════════════════════════
  //  PAGE 3: AUDIT PARAMETERS
  // ═══════════════════════════════════════════════════════════════════

  private RenderFragment RenderParamsPage() =>
  @<div>
    <div class="section-card">
      <div class="section-title">⚙️ Audit Parameters</div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">

        @* Client information *@
        <div>
          <div style="font-weight:700;color:#444;margin-bottom:.6rem;font-size:.95rem;">📋 Client Information</div>
          <div class="form-group">
            <label class="form-label">Client Name</label>
            <input class="form-control" @bind="_clientName" placeholder="Enter client name" />
          </div>
          <div class="form-group">
            <label class="form-label">Engagement Number</label>
            <input class="form-control" @bind="_engagementNumber" placeholder="e.g. ENG-2024-001" />
          </div>
          <div class="form-group">
            <label class="form-label">Audit Period Start</label>
            <input class="form-control" type="date"
                   value="@_periodStart.ToString("yyyy-MM-dd")"
                   @onchange='e => DateTime.TryParse(e.Value?.ToString(), out _periodStart)' />
          </div>
          <div class="form-group">
            <label class="form-label">Audit Period End</label>
            <input class="form-control" type="date"
                   value="@_periodEnd.ToString("yyyy-MM-dd")"
                   @onchange='e => DateTime.TryParse(e.Value?.ToString(), out _periodEnd)' />
          </div>
        </div>

        @* Materiality *@
        <div>
          <div style="font-weight:700;color:#444;margin-bottom:.6rem;font-size:.95rem;">💰 Materiality Settings</div>
          <div class="form-group">
            <label class="form-label">Materiality Unit</label>
            <select class="form-control" @bind="_materialityUnit">
              <option>Rupees</option>
              <option>Lakhs</option>
              <option>Crores</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Materiality Value (@_materialityUnit)</label>
            <input class="form-control" type="number" @bind="_materialityValue" min="0" step="0.01" />
          </div>
          <div class="form-group">
            <label class="form-label">High Risk Threshold (@_materialityUnit)</label>
            <input class="form-control" type="number" @bind="_highRiskThreshold" min="0" step="0.01" />
          </div>
          <div class="form-group">
            <label class="form-label">Large Transaction Threshold (@_materialityUnit)</label>
            <input class="form-control" type="number" @bind="_largeTxThreshold" min="0" step="0.01" />
          </div>
        </div>

        @* Control limits *@
        <div>
          <div style="font-weight:700;color:#444;margin-bottom:.6rem;font-size:.95rem;">🎛️ Control Limits</div>
          <div class="form-group">
            <label class="form-label">Round Amount Multiple</label>
            <input class="form-control" type="number" @bind="_roundAmountMultiple" min="1" />
          </div>
          <div class="form-group">
            <label class="form-label">Benford Significance Threshold (p-value)</label>
            <input class="form-control" type="number" @bind="_benfordThreshold" min="0.01" max="0.2" step="0.01" />
          </div>
          <div class="form-group">
            <label class="form-label">Sample Size (for sampling tool)</label>
            <input class="form-control" type="number" @bind="_sampleSize" min="5" max="500" />
          </div>
        </div>

        @* ML settings *@
        <div>
          <div style="font-weight:700;color:#444;margin-bottom:.6rem;font-size:.95rem;">🤖 ML Settings</div>
          <div class="form-group" style="display:flex;align-items:center;gap:.5rem;margin-top:.8rem;">
            <input type="checkbox" id="mlToggle" @bind="_enableML" style="accent-color:#667eea;width:18px;height:18px;" />
            <label for="mlToggle" style="font-size:.9rem;cursor:pointer;">Enable ML Anomaly Detection</label>
          </div>
          @if (_enableML)
          {
            <div class="alert alert-info" style="margin-top:.5rem;font-size:.82rem;">
              ML Anomaly Detection uses an Isolation Forest stub. For full ML.NET integration,
              install the <strong>Microsoft.ML</strong> NuGet package and implement the
              <code>RunIsolationForest</code> method.
            </div>
          }
        </div>
      </div>

      <div style="margin-top:1rem;text-align:right;">
        <button class="btn btn-primary" @onclick='() => { _runML = _enableML; _currentPage = "run"; }'>
          Next: Run JE Tests →
        </button>
      </div>
    </div>
  </div>;

  // ═══════════════════════════════════════════════════════════════════
  //  PAGE 4: RUN JE TESTS
  // ═══════════════════════════════════════════════════════════════════

  private RenderFragment RenderRunPage() =>
  @<div>
    <div class="section-card">
      <div class="section-title">🚀 Run JE Tests</div>
      @if (_df == null)
      {
        <div class="alert alert-warning">Please upload GL data before running tests.</div>
      }
      else
      {
        <div class="alert alert-info">
          Dataset loaded: <strong>@_df.Rows.Count.ToString("N0")</strong> entries.
          Select tests to execute and click <strong>Run Tests</strong>.
        </div>

        <div style="font-weight:700;color:#444;margin-bottom:.6rem;">Select Tests to Run:</div>
        <div class="check-group" style="margin-bottom:1rem;">
          <label class="check-item">
            <input type="checkbox" @bind="_runAmount"  /> 💵 Amount Tests
          </label>
          <label class="check-item">
            <input type="checkbox" @bind="_runTiming"  /> ⏰ Timing Tests
          </label>
          <label class="check-item">
            <input type="checkbox" @bind="_runUser"    /> 👤 User &amp; Access Control
          </label>
          <label class="check-item">
            <input type="checkbox" @bind="_runVendor"  /> 🏢 Vendor Master Data
          </label>
          <label class="check-item">
            <input type="checkbox" @bind="_runBenford" /> 📐 Benford's Law
          </label>
          <label class="check-item">
            <input type="checkbox" @bind="_runML" disabled="@(!_enableML)" /> 🤖 ML Anomaly Detection
          </label>
        </div>

        @if (_isRunning)
        {
          <div style="margin-bottom:.8rem;">
            <div style="font-size:.87rem;color:#555;margin-bottom:.3rem;">
              Running tests… @_runProgress%
            </div>
            <div class="progress-bar-wrap">
              <div class="progress-bar-fill" style="width:@(_runProgress)%;"></div>
            </div>
          </div>
        }

        <button class="btn btn-primary"
                @onclick="async () => await RunAllTests()"
                disabled="@_isRunning">
          @(_isRunning ? "⏳ Running…" : "▶ Run Tests")
        </button>

        @if (!string.IsNullOrEmpty(_runLog))
        {
          <pre style="background:#1a1a2e;color:#c9d1e8;border-radius:.6rem;padding:.8rem;margin-top:1rem;font-size:.8rem;overflow-x:auto;white-space:pre-wrap;">@_runLog</pre>
        }

        @if (_runDone && _exceptionsDF != null)
        {
          <div style="margin-top:1rem;" class="kpi-grid">
            @KpiCard("blue",   _df.Rows.Count.ToString("N0"),    "Total Entries")
            @KpiCard("red",    _exceptionsDF.AsEnumerable().Count(r => r["Risk Level"].ToString() == "Critical").ToString(), "Critical")
            @KpiCard("orange", _exceptionsDF.AsEnumerable().Count(r => r["Risk Level"].ToString() == "High").ToString(),     "High Risk")
            @KpiCard("green",  _exceptionsDF.Rows.Count.ToString("N0"), "Total Exceptions")
          </div>
          <div style="text-align:right;margin-top:.5rem;">
            <button class="btn btn-primary" @onclick='() => _currentPage = "results"'>
              View Results →
            </button>
          </div>
        }
      }
    </div>
  </div>;

  private RenderFragment KpiCard(string color, string value, string label) =>
  @<div class="kpi-card @color">
    <div class="kpi-val">@value</div>
    <div class="kpi-lbl">@label</div>
  </div>;

  // ═══════════════════════════════════════════════════════════════════
  //  PAGE 5: EXCEPTION RESULTS
  // ═══════════════════════════════════════════════════════════════════

  private RenderFragment RenderResultsPage() =>
  @<div>
    @if (!_runDone || _exceptionsDF == null)
    {
      <div class="section-card">
        <div class="alert alert-warning">Run JE Tests first to see exception results.</div>
      </div>
    }
    else
    {
      @* ── KPI Summary ── *@
      <div class="kpi-grid">
        @KpiCard("blue",   _exceptionsDF.Rows.Count.ToString("N0"),                                                                    "Total Exceptions")
        @KpiCard("red",    _exceptionsDF.AsEnumerable().Count(r => r["Risk Level"].ToString() == "Critical").ToString(),              "Critical")
        @KpiCard("orange", _exceptionsDF.AsEnumerable().Count(r => r["Risk Level"].ToString() == "High").ToString(),                  "High")
        @KpiCard("teal",   _exceptionsDF.AsEnumerable().Select(r => r["Exception Category"].ToString()).Distinct().Count().ToString(), "Categories")
        @KpiCard("purple", (_userRiskDF?.Rows.Count ?? 0).ToString(),                                                                  "Risky Users")
      </div>

      @* ── Filters ── *@
      <div class="section-card">
        <div class="section-title">🔍 Filters</div>
        <div style="display:flex;gap:.8rem;flex-wrap:wrap;align-items:flex-end;">
          <div class="form-group" style="min-width:160px;margin:0;">
            <label class="form-label">Category</label>
            <select class="form-control" @bind="_filterCategory">
              <option>All</option>
              @foreach (var cat in ExceptionCategories)
              { <option>@cat</option> }
            </select>
          </div>
          <div class="form-group" style="min-width:120px;margin:0;">
            <label class="form-label">Risk Level</label>
            <select class="form-control" @bind="_filterRisk">
              <option>All</option>
              <option>Critical</option>
              <option>High</option>
              <option>Medium</option>
              <option>Low</option>
            </select>
          </div>
          <div class="form-group" style="flex:1;min-width:160px;margin:0;">
            <label class="form-label">Keyword Search</label>
            <input class="form-control" @bind="_filterKeyword" placeholder="Search types, details…" />
          </div>
        </div>
      </div>

      @* ── Exception table ── *@
      <div class="section-card">
        <div class="section-title">📋 Exception Details</div>
        @{
          var filtered = GetFilteredExceptions();
          <div style="font-size:.83rem;color:#666;margin-bottom:.6rem;">
            Showing @filtered.Rows.Count exception(s)
          </div>
          <div style="overflow-x:auto;max-height:380px;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Exception Type</th>
                  <th>Category</th>
                  <th>Risk Level</th>
                  <th>Score</th>
                  <th>Detail</th>
                </tr>
              </thead>
              <tbody>
                @{ int rowNum = 0; }
                @foreach (DataRow r in filtered.Rows)
                {
                  rowNum++;
                  <tr>
                    <td>@rowNum</td>
                    <td>@r["Exception Type"]</td>
                    <td>@r["Exception Category"]</td>
                    <td><span class="@RiskBadgeClass(r["Risk Level"]?.ToString() ?? "Low")">@r["Risk Level"]</span></td>
                    <td>@r["Risk Score"]</td>
                    <td style="max-width:320px;word-wrap:break-word;font-size:.8rem;">@r["Detail"]</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>

      @* ── Top Risky Transactions ── *@
      @if (_txRiskDF != null && _txRiskDF.Rows.Count > 0)
      {
        <div class="section-card">
          <div class="section-title">🔥 Top Risky Transactions</div>
          <div style="overflow-x:auto;">
            <table class="data-table">
              <thead>
                <tr>
                  @foreach (DataColumn c in _txRiskDF.Columns)
                  { <th>@c.ColumnName</th> }
                </tr>
              </thead>
              <tbody>
                @foreach (DataRow r in _txRiskDF.AsEnumerable().Take(20))
                {
                  <tr>
                    @foreach (DataColumn c in _txRiskDF.Columns)
                    {
                      @if (c.ColumnName == "Risk Level")
                      { <td><span class="@RiskBadgeClass(r[c]?.ToString() ?? "Low")">@r[c]</span></td> }
                      else
                      { <td>@r[c]</td> }
                    }
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      }

      @* ── User Risk Ranking ── *@
      @if (_userRiskDF != null && _userRiskDF.Rows.Count > 0)
      {
        <div class="section-card">
          <div class="section-title">👤 User Risk Ranking</div>
          <div style="overflow-x:auto;">
            <table class="data-table">
              <thead>
                <tr>
                  @foreach (DataColumn c in _userRiskDF.Columns)
                  { <th>@c.ColumnName</th> }
                </tr>
              </thead>
              <tbody>
                @foreach (DataRow r in _userRiskDF.Rows)
                {
                  <tr>
                    @foreach (DataColumn c in _userRiskDF.Columns)
                    {
                      @if (c.ColumnName == "Risk Rating")
                      { <td><span class="@RiskBadgeClass(r[c]?.ToString() ?? "Low")">@r[c]</span></td> }
                      else
                      { <td>@r[c]</td> }
                    }
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      }

      @* ── Sampling Tool ── *@
      <div class="section-card">
        <div class="section-title">🎲 Sampling Tool</div>
        <div style="display:flex;gap:.8rem;flex-wrap:wrap;align-items:flex-end;margin-bottom:.8rem;">
          <div class="form-group" style="min-width:120px;margin:0;">
            <label class="form-label">Sample Size</label>
            <input class="form-control" type="number" @bind="_sampleCount" min="1" max="500" />
          </div>
          <div class="form-group" style="min-width:140px;margin:0;">
            <label class="form-label">Strategy</label>
            <select class="form-control" @bind="_sampleStrategy">
              <option>Random</option>
              <option>Risk-Based</option>
              <option>Systematic</option>
            </select>
          </div>
          <button class="btn btn-primary btn-sm" @onclick="GenerateSample">Generate Sample</button>
        </div>
        @if (_sampleResult != null && _sampleResult.Rows.Count > 0)
        {
          <div style="overflow-x:auto;">
            <table class="data-table">
              <thead>
                <tr>@foreach (DataColumn c in _sampleResult.Columns) { <th>@c.ColumnName</th> }</tr>
              </thead>
              <tbody>
                @foreach (DataRow r in _sampleResult.Rows)
                {
                  <tr>
                    @foreach (DataColumn c in _sampleResult.Columns)
                    {
                      @if (c.ColumnName == "Risk Level")
                      { <td><span class="@RiskBadgeClass(r[c]?.ToString() ?? "Low")">@r[c]</span></td> }
                      else
                      { <td>@r[c]</td> }
                    }
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    }
  </div>;

  // ═══════════════════════════════════════════════════════════════════
  //  PAGE 6: DASHBOARD
  // ═══════════════════════════════════════════════════════════════════

  private RenderFragment RenderDashboard() =>
  @<div>
    @if (!_runDone)
    {
      <div class="section-card">
        <div class="alert alert-warning">Run JE Tests first to populate the dashboard.</div>
      </div>
    }
    else
    {
      @* ── Summary KPIs ── *@
      <div class="kpi-grid">
        @KpiCard("blue",   (_df?.Rows.Count ?? 0).ToString("N0"),   "Total JE Entries")
        @KpiCard("red",    (_exceptionsDF?.Rows.Count ?? 0).ToString("N0"), "Total Exceptions")
        @if (_exceptionsDF != null)
        {
          @KpiCard("orange", _exceptionsDF.AsEnumerable().Count(r => r["Risk Level"].ToString() == "Critical").ToString(), "Critical Risks")
          @KpiCard("green",  _exceptionsDF.AsEnumerable().Select(r=>r["Exception Category"].ToString()).Distinct().Count().ToString(), "Categories Hit")
          var pct = _df != null && _df.Rows.Count > 0
            ? (100.0 * _exceptionsDF.Rows.Count / _df.Rows.Count).ToString("N1") + "%"
            : "—";
          @KpiCard("teal", pct, "Exception Rate")
        }
        @KpiCard("purple", (_userRiskDF?.Rows.Count ?? 0).ToString(), "Risky Users")
      </div>

      @* ── Charts row 1 ── *@
      <div style="display:grid;grid-template-columns:2fr 1fr;gap:1rem;margin-bottom:1rem;">
        <div class="section-card" style="margin:0;">
          <div class="section-title">📊 Exceptions by Category</div>
          <div class="chart-container" id="chart-category"></div>
        </div>
        <div class="section-card" style="margin:0;">
          <div class="section-title">🥧 Risk Distribution</div>
          <div class="chart-container" id="chart-risk"></div>
        </div>
      </div>

      @* ── Charts row 2 ── *@
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
        <div class="section-card" style="margin:0;">
          <div class="section-title">👤 Top Risky Users</div>
          <div class="chart-container" id="chart-users"></div>
        </div>
        <div class="section-card" style="margin:0;">
          <div class="section-title">📐 Benford's Law</div>
          <div class="chart-container" id="chart-benford"></div>
        </div>
      </div>

      @* ── Benford chi-square summary ── *@
      @if (_chi2DF != null && _chi2DF.Rows.Count > 0)
      {
        <div class="section-card">
          <div class="section-title">χ² Benford Test Results</div>
          <table class="data-table" style="max-width:400px;">
            <thead><tr><th>Statistic</th><th>Value</th></tr></thead>
            <tbody>
              @foreach (DataRow r in _chi2DF.Rows)
              {
                <tr><td>@r["Statistic"]</td><td>@r["Value"]</td></tr>
              }
            </tbody>
          </table>
        </div>
      }
    }
  </div>;

  // ═══════════════════════════════════════════════════════════════════
  //  PAGE 7: EXPORT RESULTS
  // ═══════════════════════════════════════════════════════════════════

  private RenderFragment RenderExportPage() =>
  @<div>
    @if (!_runDone)
    {
      <div class="section-card">
        <div class="alert alert-warning">Run JE Tests first before exporting.</div>
      </div>
    }
    else
    {
      @* ── Audit Working Paper ── *@
      <div class="section-card">
        <div class="section-title">📄 Audit Working Paper Preview</div>
        @{
          var conclusion   = AuditConclusion();
          var conclColor   = conclusion == "Significant" ? "#FF3B3B" : conclusion == "Moderate" ? "#FF8C00" : "#4CAF50";
          var criticalCnt  = _exceptionsDF?.AsEnumerable().Count(r => r["Risk Level"].ToString() == "Critical") ?? 0;
          var highCnt      = _exceptionsDF?.AsEnumerable().Count(r => r["Risk Level"].ToString() == "High")     ?? 0;
          var medCnt       = _exceptionsDF?.AsEnumerable().Count(r => r["Risk Level"].ToString() == "Medium")   ?? 0;
          var lowCnt       = _exceptionsDF?.AsEnumerable().Count(r => r["Risk Level"].ToString() == "Low")      ?? 0;
        }
        <div style="background:#f8f9ff;border-radius:.8rem;padding:1.5rem;border:1px solid #e8eaf6;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;margin-bottom:1.2rem;">
            <div>
              <div style="font-size:1.3rem;font-weight:700;color:#1a1a2e;">JE Audit Working Paper</div>
              <div style="color:#666;font-size:.88rem;margin-top:.2rem;">Journal Entry Analytics — Exception Summary</div>
            </div>
            <div style="text-align:right;">
              @if (!string.IsNullOrWhiteSpace(_clientName))
              { <div style="font-weight:600;">@_clientName</div> }
              @if (!string.IsNullOrWhiteSpace(_engagementNumber))
              { <div style="color:#666;font-size:.85rem;">Ref: @_engagementNumber</div> }
              <div style="color:#666;font-size:.85rem;">Period: @_periodStart.ToString("dd MMM yyyy") – @_periodEnd.ToString("dd MMM yyyy")</div>
              <div style="color:#666;font-size:.85rem;">Prepared: @DateTime.Today.ToString("dd MMM yyyy")</div>
            </div>
          </div>

          <hr style="border-color:#e8eaf6;margin-bottom:1rem;" />

          <div style="margin-bottom:1rem;">
            <div style="font-weight:700;margin-bottom:.5rem;">Executive Summary</div>
            <table class="data-table" style="max-width:460px;">
              <tr><td>Total JE Entries Reviewed</td><td><strong>@(_df?.Rows.Count.ToString("N0") ?? "—")</strong></td></tr>
              <tr><td>Total Exceptions Flagged</td><td><strong>@(_exceptionsDF?.Rows.Count.ToString("N0") ?? "0")</strong></td></tr>
              <tr><td>Critical</td><td><span class="badge badge-critical">@criticalCnt</span></td></tr>
              <tr><td>High</td><td><span class="badge badge-high">@highCnt</span></td></tr>
              <tr><td>Medium</td><td><span class="badge badge-medium">@medCnt</span></td></tr>
              <tr><td>Low</td><td><span class="badge badge-low">@lowCnt</span></td></tr>
              <tr><td>Risky Users Identified</td><td><strong>@(_userRiskDF?.Rows.Count ?? 0)</strong></td></tr>
            </table>
          </div>

          <div style="background:white;border-radius:.6rem;padding:1rem;border:2px solid @conclColor;">
            <div style="font-size:.85rem;color:#666;margin-bottom:.2rem;">Overall Audit Conclusion</div>
            <div style="font-size:1.5rem;font-weight:700;color:@conclColor;">@conclusion Risk</div>
            <div style="font-size:.85rem;color:#555;margin-top:.4rem;">
              @(conclusion == "Significant"
                ? "Significant exceptions detected. Recommend further investigation and management escalation."
                : conclusion == "Moderate"
                ? "Moderate exceptions noted. Targeted follow-up procedures recommended."
                : "Low level of exceptions detected. Standard monitoring controls appear effective.")
            </div>
          </div>
        </div>
      </div>

      @* ── Export buttons ── *@
      <div class="section-card">
        <div class="section-title">⬇️ Export Options</div>
        <div style="display:flex;gap:.8rem;flex-wrap:wrap;">
          <button class="btn btn-success" @onclick="async () => await GenerateExcelReport()">
            📊 Download Excel Report (.xlsx)
          </button>
          <button class="btn btn-primary" @onclick="async () => await GenerateCsvExport()">
            📄 Download Exceptions CSV
          </button>
        </div>
        <div class="alert alert-info" style="margin-top:.8rem;font-size:.82rem;">
          <strong>Note:</strong> Excel export requires the <code>EPPlus</code> NuGet package.
          CSV export works out-of-the-box. Add the JS helper below to <code>wwwroot/js/app.js</code>:
          <pre style="margin:.5rem 0 0;font-size:.78rem;">window.downloadFile = (name, mime, b64) => {{ const a=document.createElement('a'); a.href=`data:${{mime}};base64,${{b64}}`; a.download=name; a.click(); }};</pre>
        </div>
      </div>
    }
  </div>;

} @* end @code *@

@* ─────────────────────────────────────────────────────────────────── *@
@*  JS INTEROP HELPERS  (inline — alternatively put in wwwroot/js)     *@
@* ─────────────────────────────────────────────────────────────────── *@
<script>
  // Plotly single-trace helper
  window.renderPlotly = function (containerId, traceJson, title) {
    var el = document.getElementById(containerId);
    if (!el) return;
    try {
      var trace  = JSON.parse(traceJson);
      var layout = { title: { text: title, font: { size: 13 } }, margin: { t: 36, l: 40, r: 16, b: 60 }, paper_bgcolor: 'transparent', plot_bgcolor: 'transparent', height: 300 };
      Plotly.newPlot(containerId, [trace], layout, { responsive: true, displayModeBar: false });
    } catch(e) { console.warn('Plotly error', e); }
  };

  // Plotly multi-trace helper
  window.renderPlotlyMulti = function (containerId, tracesJson, title) {
    var el = document.getElementById(containerId);
    if (!el) return;
    try {
      var traces = JSON.parse(tracesJson);
      var layout = { title: { text: title, font: { size: 13 } }, margin: { t: 36, l: 40, r: 16, b: 60 }, paper_bgcolor: 'transparent', plot_bgcolor: 'transparent', height: 300, legend: { orientation: 'h', y: -0.2 } };
      Plotly.newPlot(containerId, traces, layout, { responsive: true, displayModeBar: false });
    } catch(e) { console.warn('Plotly error', e); }
  };

  // File download helper
  window.downloadFile = function (filename, mime, base64) {
    var a = document.createElement('a');
    a.href = 'data:' + mime + ';base64,' + base64;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  };
</script>
