  // ═══════════════════════════════════════════════════════════════════
  //  FILE PARSING
  // ═══════════════════════════════════════════════════════════════════

  /// <summary>
  /// Reads an IBrowserFile into a DataTable.
  /// Supports .csv and .xlsx/.xls (requires EPPlus for Excel).
  /// </summary>
  private async Task<DataTable?> ParseFileToDataTable(IBrowserFile file, long maxBytes = 52_428_800)
  {
    var ext = Path.GetExtension(file.Name).ToLowerInvariant();
    await using var stream = file.OpenReadStream(maxBytes);
    using var ms = new MemoryStream();
    await stream.CopyToAsync(ms);
    ms.Position = 0;

    try
    {
      if (ext == ".csv")
        return ParseCsv(ms);

      // Excel — EPPlus
      // using var package = new OfficeOpenXml.ExcelPackage(ms);
      // var ws = package.Workbook.Worksheets[0];
      // return WorksheetToDataTable(ws);

      // ↑ Uncomment once EPPlus NuGet is installed.
      // Fallback: attempt CSV parse anyway
      return ParseCsv(ms);
    }
    catch (Exception ex)
    {
      _uploadStatus = $"❌ Parse error: {ex.Message}";
      return null;
    }
  }

  private static DataTable ParseCsv(Stream stream)
  {
    var dt = new DataTable();
    using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
    string? header = reader.ReadLine();
    if (header == null) return dt;

    var cols = SplitCsvLine(header);
    foreach (var c in cols)
      dt.Columns.Add(c.Trim('"', ' '));

    string? line;
    while ((line = reader.ReadLine()) != null)
    {
      if (string.IsNullOrWhiteSpace(line)) continue;
      var vals = SplitCsvLine(line);
      var row = dt.NewRow();
      for (int i = 0; i < dt.Columns.Count && i < vals.Length; i++)
        row[i] = vals[i].Trim('"');
      dt.Rows.Add(row);
    }
    return dt;
  }

  private static string[] SplitCsvLine(string line)
  {
    var result = new List<string>();
    bool inQuotes = false;
    var current = new StringBuilder();
    foreach (char c in line)
    {
      if (c == '"') { inQuotes = !inQuotes; continue; }
      if (c == ',' && !inQuotes) { result.Add(current.ToString()); current.Clear(); continue; }
      current.Append(c);
    }
    result.Add(current.ToString());
    return result.ToArray();
  }

