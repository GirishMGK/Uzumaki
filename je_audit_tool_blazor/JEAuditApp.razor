  private string AuditConclusion()
  {
    if (_exceptionsDF == null) return "Low";
    int critical = _exceptionsDF.AsEnumerable().Count(r => r["Risk Level"].ToString() == "Critical");
    int high     = _exceptionsDF.AsEnumerable().Count(r => r["Risk Level"].ToString() == "High");
    if (critical >= 5 || high >= 20) return "Significant";
    if (critical >= 1 || high >= 5)  return "Moderate";
    return "Low";
  }

  // ─────────────────────────────────────────────────────────────────
  //  Chart helpers (Plotly.js via JS interop)
  // ─────────────────────────────────────────────────────────────────
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_currentPage == "dashboard" && _runDone)
      await RenderChartsAsync();
  }

  private async Task RenderChartsAsync()
  {
    try
    {
      if (_exceptionsDF != null && _exceptionsDF.Rows.Count > 0)
      {
        // Bar chart: exceptions by category
        var catGroups = _exceptionsDF.AsEnumerable()
          .GroupBy(r => r["Exception Category"].ToString())
          .ToDictionary(g => g.Key!, g => g.Count());
        var catJson = JsonSerializer.Serialize(new
        {
          x = catGroups.Keys.ToArray(),
          y = catGroups.Values.ToArray(),
          type = "bar",
          marker = new { color = "#667eea" }
        });
        await JSRuntime.InvokeVoidAsync("renderPlotly", "chart-category", catJson, "Exception Count by Category");

        // Pie: risk breakdown
        var riskGroups = _exceptionsDF.AsEnumerable()
          .GroupBy(r => r["Risk Level"].ToString())
          .ToDictionary(g => g.Key!, g => g.Count());
        var pieJson = JsonSerializer.Serialize(new
        {
          labels  = riskGroups.Keys.ToArray(),
          values  = riskGroups.Values.ToArray(),
          type    = "pie",
          hole    = 0.4,
          marker  = new { colors = new[]{ "#FF3B3B","#FF8C00","#F5A623","#4CAF50" } }
        });
        await JSRuntime.InvokeVoidAsync("renderPlotly", "chart-risk", pieJson, "Risk Distribution");

        // User exception bar
        if (_userRiskDF != null && _userRiskDF.Rows.Count > 0)
        {
          var top10Users = _userRiskDF.AsEnumerable().Take(10).ToList();
          var userBarJson = JsonSerializer.Serialize(new
          {
            x    = top10Users.Select(r => r["User ID"].ToString()).ToArray(),
            y    = top10Users.Select(r => Convert.ToDouble(r["Total Risk Score"])).ToArray(),
            type = "bar",
            marker = new { color = "#764ba2" }
          });
          await JSRuntime.InvokeVoidAsync("renderPlotly", "chart-users", userBarJson, "Top 10 Risky Users");
        }

        // Benford chart
        if (_benfordDF != null && _benfordDF.Rows.Count > 0)
        {
          var digits   = Enumerable.Range(1, 9).Select(d => d.ToString()).ToArray();
          var expected = _benfordDF.AsEnumerable().Select(r => Convert.ToDouble(r["Expected"])).ToArray();
          var observed = _benfordDF.AsEnumerable().Select(r => Convert.ToDouble(r["Observed"])).ToArray();
          var benfordJson = JsonSerializer.Serialize(new object[]
          {
            new { x=digits, y=expected, type="bar", name="Expected", marker=new{color="#667eea"} },
            new { x=digits, y=observed, type="scatter", mode="lines+markers", name="Observed", line=new{color="#FF3B3B"} }
          });
          await JSRuntime.InvokeVoidAsync("renderPlotlyMulti", "chart-benford", benfordJson, "Benford's Law Analysis");
        }
      }
    }
    catch { /* JS interop may not be ready on first render */ }
  }

