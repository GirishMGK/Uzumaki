  // ═══════════════════════════════════════════════════════════════════
  //  COLUMN AUTO-MAPPING
  // ═══════════════════════════════════════════════════════════════════

  private void AutoMapColumns()
  {
    if (_df == null) return;
    _colMap.Clear();

    var aliases = new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase)
    {
      ["doc_number"]        = new[]{"doc_number","document_number","docno","doc no","voucher","voucher_no","journal_no"},
      ["doc_date"]          = new[]{"doc_date","document_date","docdate","journal_date","jnl_date"},
      ["posting_date"]      = new[]{"posting_date","postingdate","post_date","value_date"},
      ["entry_date"]        = new[]{"entry_date","entrydate","created_date","input_date","entered_date"},
      ["doc_type"]          = new[]{"doc_type","document_type","doctype","type"},
      ["posting_key"]       = new[]{"posting_key","postingkey","pk","debit_credit_key"},
      ["gl_account"]        = new[]{"gl_account","glaccount","account","account_no","gl_no","gl no"},
      ["gl_desc"]           = new[]{"gl_desc","gl_description","account_desc","account_name","description"},
      ["amount"]            = new[]{"amount","amt","value","transaction_amount","lc_amount"},
      ["dc_indicator"]      = new[]{"dc_indicator","dc","debit_credit","d_c","indicator"},
      ["vendor_code"]       = new[]{"vendor_code","vendor_no","vendorno","vendor number","lifnr"},
      ["vendor_name"]       = new[]{"vendor_name","vendor","supplier","supplier_name"},
      ["customer"]          = new[]{"customer","customer_code","customer_no","kunnr"},
      ["invoice_ref"]       = new[]{"invoice_ref","invoice","invoice_no","invoice_number","ref"},
      ["purchase_doc"]      = new[]{"purchase_doc","po_number","purchase_order","ebeln"},
      ["clearing_doc"]      = new[]{"clearing_doc","cleared_doc","augbl"},
      ["user_id"]           = new[]{"user_id","user","userid","created_by","entered_by","username"},
      ["approval_id"]       = new[]{"approval_id","approved_by","approver","genehmiger"},
      ["assignment"]        = new[]{"assignment","zuonr"},
      ["reference"]         = new[]{"reference","xblnr","ref_doc"},
      ["text"]              = new[]{"text","narration","description","remarks","bktxt"},
      ["reversal_indicator"]= new[]{"reversal_indicator","reversal","stgrd","reversal_reason"},
      ["cost_center"]       = new[]{"cost_center","costcenter","kostl"},
      ["profit_center"]     = new[]{"profit_center","profitcenter","prctr"},
      ["offset_account"]    = new[]{"offset_account","offsetaccount","hkont"},
      ["wbs"]               = new[]{"wbs","wbs_element","posid"},
      ["sales_doc"]         = new[]{"sales_doc","sales_order","vbeln"},
      ["billing_doc"]       = new[]{"billing_doc","billing","vbeln_vf"},
      ["asset"]             = new[]{"asset","asset_no","anln1"},
      ["order"]             = new[]{"order","internal_order","aufnr"},
      ["wht_amount"]        = new[]{"wht_amount","withholding_tax","wt_base"},
      ["collective_inv"]    = new[]{"collective_inv","collective_invoice"},
      ["grouping"]          = new[]{"grouping","group"},
      ["sub_grouping"]      = new[]{"sub_grouping","subgroup","sub_group"},
    };

    var actualCols = _df.Columns.Cast<DataColumn>().Select(c => c.ColumnName).ToList();

    foreach (var (field, candidates) in aliases)
    {
      foreach (var candidate in candidates)
      {
        var match = actualCols.FirstOrDefault(c =>
          string.Equals(c, candidate, StringComparison.OrdinalIgnoreCase) ||
          c.Replace(" ","_").Equals(candidate, StringComparison.OrdinalIgnoreCase));
        if (match != null) { _colMap[field] = match; break; }
      }
    }
  }

  private string ColVal(DataRow row, string field)
  {
    if (_colMap.TryGetValue(field, out var col) && _df!.Columns.Contains(col))
      return row[col]?.ToString() ?? "";
    return "";
  }

  private decimal ParseAmount(string s)
  {
    s = s.Replace(",", "").Replace("(", "-").Replace(")", "");
    return decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : 0m;
  }

  // ═══════════════════════════════════════════════════════════════════
  //  TEST RUNNER
  // ═══════════════════════════════════════════════════════════════════

  private async Task RunAllTests()
  {
    if (_df == null) { _runLog = "⚠ No data loaded."; return; }
    _isRunning  = true;
    _runProgress = 0;
    _runLog      = "";
    _runDone     = false;
    var allExceptions = new DataTable();
    allExceptions.Columns.Add("original_index", typeof(int));
    allExceptions.Columns.Add("Exception Type");
    allExceptions.Columns.Add("Exception Category");
    allExceptions.Columns.Add("Risk Level");
    allExceptions.Columns.Add("Risk Score", typeof(decimal));
    allExceptions.Columns.Add("Detail");

    int step = 0;
    int totalSteps = (_runAmount?1:0) + (_runTiming?1:0) + (_runUser?1:0) +
                     (_runVendor?1:0) + (_runBenford?1:0) + (_runML?1:0);
    if (totalSteps == 0) { _isRunning = false; return; }

    void AddExceptions(DataTable src)
    {
      foreach (DataRow r in src.Rows)
        allExceptions.ImportRow(r);
    }

    async Task Tick(string msg)
    {
      step++;
      _runProgress = (int)(step * 100.0 / totalSteps);
      _runLog += $"\n✔ {msg}";
      StateHasChanged();
      await Task.Delay(50);
    }

    if (_runAmount)  { AddExceptions(RunAmountTests());  await Tick("Amount Tests completed"); }
    if (_runTiming)  { AddExceptions(RunTimingTests());  await Tick("Timing Tests completed"); }
    if (_runUser)    { AddExceptions(RunUserTests());    await Tick("User & Access Control completed"); }
    if (_runVendor)  { AddExceptions(RunVendorTests());  await Tick("Vendor Master Data completed"); }
    if (_runBenford) { RunBenfordTest();                 await Tick("Benford's Law completed"); }
    if (_runML)      { AddExceptions(RunIsolationForest()); await Tick("ML Anomaly Detection completed"); }

    _exceptionsDF = allExceptions;
    _txRiskDF     = CalculateTransactionRisk(allExceptions);
    _userRiskDF   = RankUsers(allExceptions);
    _runDone      = true;
    _isRunning    = false;
    _runProgress  = 100;
    _runLog      += $"\n\n✅ Done — {allExceptions.Rows.Count} exception(s) flagged.";
    StateHasChanged();
  }

  // ─────────────────────────────────────────────────────────────────
  //  Amount Tests
  // ─────────────────────────────────────────────────────────────────
  private DataTable RunAmountTests()
  {
    var dt = MakeExceptionTable();
    if (_df == null) return dt;

    decimal materialityAbs = _materialityUnit switch
    {
      "Crores" => _materialityValue * 10_000_000m,
      "Lakhs"  => _materialityValue * 100_000m,
      _        => _materialityValue
    };
    decimal largeTxAbs = _largeTxThreshold * (_materialityUnit switch
    {
      "Crores" => 10_000_000m, "Lakhs" => 100_000m, _ => 1m
    });

    int idx = 0;
    foreach (DataRow row in _df.Rows)
    {
      var amtStr = ColVal(row, "amount");
      var amt    = Math.Abs(ParseAmount(amtStr));

      // Round-number amounts
      if (amt > 0 && _roundAmountMultiple > 0 && amt % _roundAmountMultiple == 0)
        AddException(dt, idx, "Round Number Amount", "Amount & Materiality", "Medium", 4m,
          $"Amount {amt:N0} is a round multiple of {_roundAmountMultiple}");

      // Large transactions above materiality
      if (amt >= materialityAbs && materialityAbs > 0)
        AddException(dt, idx, "Above Materiality", "Amount & Materiality", "High", 7m,
          $"Amount {amt:N0} exceeds materiality {materialityAbs:N0}");

      // Very large transactions
      if (amt >= largeTxAbs && largeTxAbs > 0)
        AddException(dt, idx, "Large Transaction", "Amount & Materiality", "Critical", 9m,
          $"Amount {amt:N0} exceeds large-transaction threshold {largeTxAbs:N0}");

      // Zero-amount entries
      if (amt == 0)
        AddException(dt, idx, "Zero Amount Entry", "Amount & Materiality", "Low", 2m,
          "Journal entry has zero amount");

      // Negative / credit entries in unusual accounts
      var dc = ColVal(row, "dc_indicator").ToUpper();
      var gl  = ColVal(row, "gl_account");
      if (dc == "C" && gl.StartsWith("1")) // debit-normally accounts credited
        AddException(dt, idx, "Unusual Credit Entry", "Amount & Materiality", "Medium", 5m,
          $"Credit entry on GL {gl} which is normally a debit account");

      idx++;
    }
    return dt;
  }

  // ─────────────────────────────────────────────────────────────────
  //  Timing Tests
  // ─────────────────────────────────────────────────────────────────
  private DataTable RunTimingTests()
  {
    var dt = MakeExceptionTable();
    if (_df == null) return dt;

    // Build weekend + holiday set
    var holidays = new HashSet<DateTime>(_customHolidays.Select(d => d.Date));

    int idx = 0;
    foreach (DataRow row in _df.Rows)
    {
      var entryDateStr   = ColVal(row, "entry_date");
      var postingDateStr = ColVal(row, "posting_date");
      var docDateStr     = ColVal(row, "doc_date");

      DateTime.TryParse(entryDateStr,   out var entryDt);
      DateTime.TryParse(postingDateStr, out var postDt);
      DateTime.TryParse(docDateStr,     out var docDt);

      // Weekend entries
      if (entryDt != default &&
          (entryDt.DayOfWeek == DayOfWeek.Saturday || entryDt.DayOfWeek == DayOfWeek.Sunday))
        AddException(dt, idx, "Weekend Entry", "Timing & Scheduling", "Medium", 5m,
          $"Entry made on {entryDt:ddd dd-MMM-yyyy}");

      // Holiday entries
      if (entryDt != default && holidays.Contains(entryDt.Date))
        AddException(dt, idx, "Holiday Entry", "Timing & Scheduling", "High", 7m,
          $"Entry made on holiday {entryDt:dd-MMM-yyyy}");

      // Late-night entries (outside 08:00-20:00)
      if (entryDt != default && (entryDt.Hour < 8 || entryDt.Hour >= 20))
        AddException(dt, idx, "Off-Hours Entry", "Timing & Scheduling", "Medium", 5m,
          $"Entry at {entryDt:HH:mm} (outside business hours)");

      // Back-dated entries (doc_date earlier than posting_date by >30 days)
      if (docDt != default && postDt != default && (postDt - docDt).TotalDays > 30)
        AddException(dt, idx, "Back-Dated Entry", "Timing & Scheduling", "High", 7m,
          $"Doc date {docDt:dd-MMM-yyyy}, Posting date {postDt:dd-MMM-yyyy} — {(postDt-docDt).Days} days gap");

      // Future-dated entries
      if (postDt != default && postDt.Date > _periodEnd)
        AddException(dt, idx, "Future-Dated Entry", "Timing & Scheduling", "Critical", 9m,
          $"Posting date {postDt:dd-MMM-yyyy} is after period end {_periodEnd:dd-MMM-yyyy}");

      // Period-end entries (last 3 days of month)
      if (postDt != default)
      {
        int daysInMonth = DateTime.DaysInMonth(postDt.Year, postDt.Month);
        if (postDt.Day >= daysInMonth - 2)
          AddException(dt, idx, "Period-End Entry", "Timing & Scheduling", "Medium", 4m,
            $"Posting date {postDt:dd-MMM-yyyy} is within last 3 days of month");
      }

      idx++;
    }
    return dt;
  }

  // ─────────────────────────────────────────────────────────────────
  //  User & Access Control Tests
  // ─────────────────────────────────────────────────────────────────
  private DataTable RunUserTests()
  {
    var dt = MakeExceptionTable();
    if (_df == null) return dt;

    // Count entries per user
    var userCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    foreach (DataRow row in _df.Rows)
    {
      var u = ColVal(row, "user_id");
      if (!string.IsNullOrWhiteSpace(u))
        userCounts[u] = userCounts.GetValueOrDefault(u) + 1;
    }
    double mean  = userCounts.Values.Any() ? userCounts.Values.Average() : 0;
    double stdev = userCounts.Values.Any()
      ? Math.Sqrt(userCounts.Values.Select(v => Math.Pow(v - mean, 2)).Average())
      : 0;

    int idx = 0;
    foreach (DataRow row in _df.Rows)
    {
      var userId     = ColVal(row, "user_id");
      var approvalId = ColVal(row, "approval_id");

      // Self-approved entries
      if (!string.IsNullOrWhiteSpace(userId) &&
          !string.IsNullOrWhiteSpace(approvalId) &&
          userId.Equals(approvalId, StringComparison.OrdinalIgnoreCase))
        AddException(dt, idx, "Self-Approved Entry", "User & Access Control", "Critical", 9m,
          $"User {userId} approved their own entry");

      // Missing user ID
      if (string.IsNullOrWhiteSpace(userId))
        AddException(dt, idx, "Missing User ID", "User & Access Control", "High", 7m,
          "Entry has no user ID — may indicate system-generated or tampered entry");

      // Missing approval ID
      if (string.IsNullOrWhiteSpace(approvalId))
        AddException(dt, idx, "Missing Approval ID", "User & Access Control", "Medium", 5m,
          "Entry has no approval ID — segregation of duties risk");

      // High-volume user (> mean + 2*stdev)
      if (!string.IsNullOrWhiteSpace(userId) &&
          stdev > 0 &&
          userCounts.GetValueOrDefault(userId) > mean + 2 * stdev)
        AddException(dt, idx, "High-Volume User", "User & Access Control", "Medium", 4m,
          $"User {userId} has {userCounts[userId]} entries (threshold: {mean + 2*stdev:N0})");

      idx++;
    }
    return dt;
  }

  // ─────────────────────────────────────────────────────────────────
  //  Vendor Master Data Tests
  // ─────────────────────────────────────────────────────────────────
  private DataTable RunVendorTests()
  {
    var dt = MakeExceptionTable();
    if (_df == null) return dt;

    // Build related-party set
    var relatedCodes = new HashSet<string>(
      _relatedPartyList
        .SelectMany(d => d.Values)
        .Where(v => !string.IsNullOrWhiteSpace(v)),
      StringComparer.OrdinalIgnoreCase);

    // Build vendor master lookup (vendor_code → vendor_name)
    var vendorMaster = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    if (_vendorMasterDF != null)
    {
      foreach (DataRow r in _vendorMasterDF.Rows)
      {
        var code = r[0]?.ToString() ?? "";
        var name = _vendorMasterDF.Columns.Count > 1 ? r[1]?.ToString() ?? "" : "";
        if (!string.IsNullOrWhiteSpace(code))
          vendorMaster[code] = name;
      }
    }

    int idx = 0;
    foreach (DataRow row in _df.Rows)
    {
      var vendorCode = ColVal(row, "vendor_code");
      var vendorName = ColVal(row, "vendor_name");
      var docType    = ColVal(row, "doc_type");
      var amtStr     = ColVal(row, "amount");
      var amt        = Math.Abs(ParseAmount(amtStr));

      // Related party transactions
      if (!string.IsNullOrWhiteSpace(vendorCode) && relatedCodes.Contains(vendorCode))
        AddException(dt, idx, "Related Party Transaction", "Vendor Master Data", "Critical", 9m,
          $"Vendor {vendorCode} ({vendorName}) is a related party");

      // Vendor not in master
      if (!string.IsNullOrWhiteSpace(vendorCode) && vendorMaster.Any() && !vendorMaster.ContainsKey(vendorCode))
        AddException(dt, idx, "Vendor Not in Master", "Vendor Master Data", "High", 7m,
          $"Vendor code {vendorCode} not found in vendor master");

      // Name mismatch
      if (!string.IsNullOrWhiteSpace(vendorCode) && vendorMaster.ContainsKey(vendorCode))
      {
        var masterName = vendorMaster[vendorCode];
        if (!string.IsNullOrWhiteSpace(vendorName) &&
            !vendorName.Equals(masterName, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(masterName))
          AddException(dt, idx, "Vendor Name Mismatch", "Vendor Master Data", "High", 7m,
            $"Transaction: '{vendorName}' vs Master: '{masterName}'");
      }

      // Payment without PO reference
      if ((docType == "KR" || docType == "RE") &&
          string.IsNullOrWhiteSpace(ColVal(row, "purchase_doc")) &&
          amt > 0)
        AddException(dt, idx, "Payment Without PO", "Vendor Master Data", "Medium", 5m,
          $"Vendor payment (doc type {docType}) with no purchase order reference");

      idx++;
    }
    return dt;
  }

  // ─────────────────────────────────────────────────────────────────
  //  Benford's Law Test
  // ─────────────────────────────────────────────────────────────────
  private void RunBenfordTest()
  {
    if (_df == null) return;

    // Expected Benford distribution for digits 1-9
    double[] expected = { .301, .176, .125, .097, .079, .067, .058, .051, .046 };

    var counts = new int[9]; // index 0 = digit 1, ..., index 8 = digit 9
    int total  = 0;

    foreach (DataRow row in _df.Rows)
    {
      var amtStr = ColVal(row, "amount");
      var amt    = Math.Abs(ParseAmount(amtStr));
      if (amt <= 0) continue;

      // First significant digit
      var digits = amt.ToString("0").TrimStart('0');
      if (digits.Length > 0 && char.IsDigit(digits[0]))
      {
        int d = digits[0] - '0';
        if (d >= 1 && d <= 9) { counts[d - 1]++; total++; }
      }
    }

    var benford = new DataTable();
    benford.Columns.Add("Digit",    typeof(int));
    benford.Columns.Add("Expected", typeof(double));
    benford.Columns.Add("Observed", typeof(double));
    benford.Columns.Add("Count",    typeof(int));

    var chi2 = new DataTable();
    chi2.Columns.Add("Statistic", typeof(string));
    chi2.Columns.Add("Value",     typeof(double));

    double chiSqStat = 0;
    for (int i = 0; i < 9; i++)
    {
      double obs = total > 0 ? (double)counts[i] / total : 0;
      double exp = expected[i];
      benford.Rows.Add(i + 1, Math.Round(exp, 4), Math.Round(obs, 4), counts[i]);
      double exp_n = exp * total;
      if (exp_n > 0) chiSqStat += Math.Pow(counts[i] - exp_n, 2) / exp_n;
    }
    // df=8, critical value at 0.05 = 15.507
    bool significant = chiSqStat > 15.507;
    chi2.Rows.Add("Chi-Square Statistic", Math.Round(chiSqStat, 4));
    chi2.Rows.Add("Critical Value (α=0.05)", 15.507);
    chi2.Rows.Add("Significant Deviation", significant ? 1.0 : 0.0);

    _benfordDF = benford;
    _chi2DF    = chi2;
  }

  // ─────────────────────────────────────────────────────────────────
  //  ML Anomaly Detection (Isolation Forest stub)
  // ─────────────────────────────────────────────────────────────────
  private DataTable RunIsolationForest()
  {
    var dt = MakeExceptionTable();
    if (_df == null) return dt;

    // Stub: flag top-5% by amount as anomalies (replace with ML.NET IsolationForest)
    var amounts = new List<(int idx, decimal amt)>();
    int i = 0;
    foreach (DataRow row in _df.Rows)
    {
      var a = Math.Abs(ParseAmount(ColVal(row, "amount")));
      amounts.Add((i, a));
      i++;
    }
    var sorted  = amounts.OrderByDescending(x => x.amt).ToList();
    int topCount = Math.Max(1, (int)(sorted.Count * 0.05));
    foreach (var (rowIdx, amt) in sorted.Take(topCount))
      AddException(dt, rowIdx, "ML Anomaly (High Amount)", "System & Entry Nature", "High", 7m,
        $"Isolation Forest flagged amount {amt:N0} as anomalous (top 5%)");

    return dt;
  }

  // ─────────────────────────────────────────────────────────────────
  //  Risk calculation helpers
  // ─────────────────────────────────────────────────────────────────
  private static DataTable MakeExceptionTable()
  {
    var dt = new DataTable();
    dt.Columns.Add("original_index",    typeof(int));
    dt.Columns.Add("Exception Type");
    dt.Columns.Add("Exception Category");
    dt.Columns.Add("Risk Level");
    dt.Columns.Add("Risk Score",        typeof(decimal));
    dt.Columns.Add("Detail");
    return dt;
  }

  private static void AddException(DataTable dt, int idx, string type, string category,
                                   string risk, decimal score, string detail)
    => dt.Rows.Add(idx, type, category, risk, score, detail);

  private DataTable CalculateTransactionRisk(DataTable exceptions)
  {
    // Aggregate risk per original_index
    var groups = exceptions.AsEnumerable()
      .GroupBy(r => (int)r["original_index"])
      .Select(g => new
      {
        Index    = g.Key,
        Score    = g.Sum(r => (decimal)r["Risk Score"]),
        Count    = g.Count(),
        TopRisk  = g.OrderByDescending(r => (decimal)r["Risk Score"])
                    .First()["Risk Level"].ToString()!,
        Types    = string.Join("; ", g.Select(r => r["Exception Type"]).Distinct())
      })
      .OrderByDescending(x => x.Score)
      .ToList();

    var dt = new DataTable();
    dt.Columns.Add("Row #",           typeof(int));
    dt.Columns.Add("Risk Score",      typeof(decimal));
    dt.Columns.Add("Exception Count", typeof(int));
    dt.Columns.Add("Risk Level");
    dt.Columns.Add("Exception Types");
    dt.Columns.Add("Amount");
    dt.Columns.Add("User ID");

    foreach (var g in groups)
    {
      string amt = _df != null && g.Index < _df.Rows.Count
        ? ColVal(_df.Rows[g.Index], "amount") : "";
      string uid = _df != null && g.Index < _df.Rows.Count
        ? ColVal(_df.Rows[g.Index], "user_id") : "";
      dt.Rows.Add(g.Index + 1, g.Score, g.Count, g.TopRisk, g.Types, amt, uid);
    }
    return dt;
  }

  private DataTable RankUsers(DataTable exceptions)
  {
    if (_df == null) return new DataTable();

    var userScores = new Dictionary<string, (decimal score, int count)>(StringComparer.OrdinalIgnoreCase);
    foreach (DataRow r in exceptions.Rows)
    {
      int rowIdx = (int)r["original_index"];
      if (rowIdx >= _df.Rows.Count) continue;
      var uid = ColVal(_df.Rows[rowIdx], "user_id");
      if (string.IsNullOrWhiteSpace(uid)) uid = "(unknown)";
      var score = (decimal)r["Risk Score"];
      var (prevScore, prevCount) = userScores.GetValueOrDefault(uid, (0m, 0));
      userScores[uid] = (prevScore + score, prevCount + 1);
    }

    var dt = new DataTable();
    dt.Columns.Add("User ID");
    dt.Columns.Add("Total Risk Score", typeof(decimal));
    dt.Columns.Add("Exception Count",  typeof(int));
    dt.Columns.Add("Risk Rating");

    foreach (var (uid, (score, cnt)) in userScores.OrderByDescending(k => k.Value.score))
    {
      string rating = score >= 50 ? "Critical" : score >= 20 ? "High" : score >= 10 ? "Medium" : "Low";
      dt.Rows.Add(uid, score, cnt, rating);
    }
    return dt;
  }

  // ─────────────────────────────────────────────────────────────────
  //  Sampling
  // ─────────────────────────────────────────────────────────────────
  private void GenerateSample()
  {
    if (_exceptionsDF == null || _exceptionsDF.Rows.Count == 0) return;
    var filtered = GetFilteredExceptions();
    if (filtered.Rows.Count == 0) return;

    var rng  = new Random();
    var rows = filtered.AsEnumerable().ToList();

    IEnumerable<DataRow> selected = _sampleStrategy switch
    {
      "Risk-Based" => rows.OrderByDescending(r => (decimal)r["Risk Score"]).Take(_sampleCount),
      "Systematic" => rows.Where((_, i) => i % Math.Max(1, rows.Count / _sampleCount) == 0).Take(_sampleCount),
      _            => rows.OrderBy(_ => rng.Next()).Take(_sampleCount)
    };

    _sampleResult = selected.Any() ? selected.CopyToDataTable() : null;
  }

  // ─────────────────────────────────────────────────────────────────
  //  Filtering helper
  // ─────────────────────────────────────────────────────────────────
  private DataTable GetFilteredExceptions()
  {
    if (_exceptionsDF == null) return new DataTable();
    var rows = _exceptionsDF.AsEnumerable();

    if (_filterCategory != "All")
      rows = rows.Where(r => r["Exception Category"].ToString() == _filterCategory);
    if (_filterRisk != "All")
      rows = rows.Where(r => r["Risk Level"].ToString() == _filterRisk);
    if (!string.IsNullOrWhiteSpace(_filterKeyword))
    {
      var kw = _filterKeyword.ToLower();
      rows = rows.Where(r =>
        r["Exception Type"].ToString()!.ToLower().Contains(kw) ||
        r["Detail"].ToString()!.ToLower().Contains(kw));
    }
    var list = rows.ToList();
    return list.Any() ? list.CopyToDataTable() : _exceptionsDF.Clone();
  }

