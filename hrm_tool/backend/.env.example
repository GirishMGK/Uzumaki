RMS_DATABASE_URL=postgresql+psycopg://rms:rms@db:5432/firm_rms
RMS_JWT_SECRET_KEY=replace-with-a-long-random-value
RMS_ENVIRONMENT=production
RMS_CORS_ORIGINS=["http://localhost:5173"]

# Optional SMTP for notifications (§9)
RMS_SMTP_HOST=
RMS_SMTP_PORT=587
RMS_SMTP_USER=
RMS_SMTP_PASSWORD=
RMS_SMTP_FROM=rms@firm.local

# Optional Google Workspace SSO (§16 Q8) — leave blank until confirmed available
RMS_GOOGLE_OAUTH_CLIENT_ID=
RMS_GOOGLE_OAUTH_CLIENT_SECRET=
